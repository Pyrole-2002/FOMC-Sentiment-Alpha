# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Environments ---------------------------------------------------------
.venv/
venv/
.env

# --- Data -----------------------------------------------------------------
# Raw scraped HTML and derived artefacts are REGENERATED by the pipeline, not
# version-controlled. Committing them would bloat the repo and, worse, blur the
# line between "code that produces a result" and "the result" -- reproducibility
# means anyone can rebuild data/ from src/ alone.
#
# EXCEPTION: data/raw/manifest.csv IS committed (see !rule below). It records the
# URL + sha256 + fetch timestamp of every raw file, so a third party can verify
# byte-for-byte that their scrape matches ours without us shipping the bytes.
# Note the pattern: `data/**` and NOT `data/`. Git cannot re-include a file whose
# *parent directory* is excluded, so `data/` + `!data/**/.gitkeep` silently fails
# to keep the directory skeleton. Excluding the contents (`data/**`) while
# re-including directories (`!data/**/`) makes the negations below work.
data/**
!data/**/
!data/**/.gitkeep
!data/raw/manifest.csv

# --- Model / notebook artefacts ------------------------------------------
*.ckpt
*.pt
*.safetensors
.ipynb_checkpoints/
reports/*.html
!reports/.gitkeep

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
# Per-machine tool permissions, not project config.
# (gitignore only honours whole-line comments, never trailing ones -- a
#  trailing "# ..." becomes part of the pattern and the rule silently misses.)
.claude/settings.local.json
